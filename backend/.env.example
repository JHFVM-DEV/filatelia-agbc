# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - FILATELIA BOLIVIA (CORREOS DE BOLIVIA)
# ==============================================================================
# Copie este archivo como .env en el servidor: cp .env.example .env
# Luego ejecute: php artisan key:generate
# ==============================================================================

APP_NAME="Filatelia Bolivia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# ------------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (PRODUCCIÓN)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=filatelia_db
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_postgres

# ------------------------------------------------------------------------------
# SESIONES, CACHÉ Y COLAS ALMACENADAS EN POSTGRESQL
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# INTEGRACIÓN FRONTEND & CORS (NEXT.JS)
# ------------------------------------------------------------------------------
# Indique la URL del Frontend para que el backend acepte peticiones
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ------------------------------------------------------------------------------
# LOGS Y TELEMETRÍA DE ERRORES
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
BCRYPT_ROUNDS=12
